# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server Port (fixed 3000 in AI Studio environment)
PORT=3000
NODE_ENV="development"

# MongoDB Atlas URI (falls back to safe in-memory data store if empty)
MONGO_URI=""

# Cloudinary Configuration for ID Card uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP / Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="adg.deception@student.sfit.ac.in"

# JWT Authentication
JWT_SECRET="deception_adg_jwt_secret_2026_super_secure_key"

# Payment Module Integration
MOCK_PAYMENT="true"
PAYMENT_SERVICE_URL=""
